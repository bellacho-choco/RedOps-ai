# REDOPS-OMEGA environment template. Copy to .env and fill in.
# NEVER commit a real .env.

# Optional live threat research (BEAT #2). Without it, /api/intel/research
# degrades gracefully to status NO_KEY.
TAVILY_API_KEY=

# Optional real container sandbox (BEAT #1 gateway tool 'sandbox_exec' upgrades
# from SIMULATED to REAL when the docker daemon is reachable).
REDOPS_SANDBOX_IMAGE=kalilinux/kali-rolling:latest

# Optional write-behind graph replica (BEAT #3). Queries stay in-memory.
NEO4J_URI=

# LLM provider (overlord reasoning). Blank -> deterministic local fallback.
REDOPS_LLM_ENDPOINT=
REDOPS_LLM_KEY=
